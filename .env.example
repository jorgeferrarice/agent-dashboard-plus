# Copy to .env and fill in, or let ./setup.sh write it.
# .env is git-ignored: it holds secrets.

# Container runtime for compose: docker or podman.
CONTAINER_RUNTIME=docker

# Session signing key. Generate: openssl rand -hex 32
SECRET_KEY=

# Token the host daemon uses to authenticate to the backend.
# Generate: openssl rand -hex 24
HOST_TOKEN=

# Where the browser reaches the dashboard (no trailing slash).
# Local: http://localhost:8080. With a tunnel: https://your.domain
VITE_API_URL=http://localhost:8080

# Where the host daemon reaches the backend.
DASHBOARD_URL=http://localhost:8000

# Login. true turns it off: only for a dashboard reachable from
# this machine alone. Never expose it to a network like that.
BYPASS_AUTH=false

# Google OAuth (or any OIDC provider). Redirect URI to register
# with the provider: <VITE_API_URL>/auth
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# Comma-separated e-mails allowed to sign in. Without it, any
# account the provider signs in gets a shell on your hosts.
ALLOWED_EMAILS=

# Folders the daemon offers as projects.
PROJECTS_ROOT=
PROJECTS_FOLDER_DEPTH=2
NEW_PROJECTS_DIR=
